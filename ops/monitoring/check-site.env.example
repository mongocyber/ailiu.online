# Public, site-specific values. Do not place webhook URLs or tokens here.
SITE_HOST=ailiu.online
SITE_BASE_URL=https://ailiu.online
MONITOR_STATE_DIR=/var/lib/ailiu-monitor
DEPLOYMENT_ID_FILE=/etc/ailiu-monitor/current-deployment-id
HTTP_TIMEOUT_SECONDS=4

# Activation must point these at owner-approved, non-repository curl config
# files whose URLs/headers are treated as secrets. Empty means fail closed.
ALERT_CURL_CONFIG_FILE=
HEARTBEAT_CURL_CONFIG_FILE=
