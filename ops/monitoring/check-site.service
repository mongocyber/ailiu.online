[Unit]
Description=ailiu.online external availability check
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=ailiu-monitor
Group=ailiu-monitor
EnvironmentFile=/etc/ailiu-monitor/check-site.env
ExecStart=/opt/ailiu-monitor/check-site.sh
StateDirectory=ailiu-monitor
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/ailiu-monitor
CapabilityBoundingSet=
AmbientCapabilities=
LockPersonality=true
MemoryDenyWriteExecute=true
ProtectClock=true
ProtectControlGroups=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native
TimeoutStartSec=50s
StandardOutput=journal
StandardError=journal
